# Optional for development: copy to .env (ignored by Git) to override the defaults in compose.yaml.
# The defaults are placeholders for a local development stack; the database port is not published.
# Required for the production profile (compose.prod.yaml): the three secrets below, to values of your own. It
# refuses to start with these placeholders (README, "Production").

# Host ports
APP_PORT=8471
FRONTEND_PORT=5471

# Replace with your own random values (for example: openssl rand -hex 32)
POSTGRES_PASSWORD=!ChangeMe!
APP_DATABASE_PASSWORD=!ChangeMe!
APP_SECRET=!ChangeMe!

# Production profile only (README, "Production")
# PROD_PORT=8490
# SERVER_NAME=scorewright.example.com
# TRUSTED_HOSTS=^scorewright\.example\.com$
# TRUSTED_PROXIES=private_ranges
