# Optional, for the development stack (compose.yaml): copy to .env (ignored by Git) to change its defaults. They are
# placeholders for a stack on your own machine; the database port is not published. The production profile has a file
# of its own: .env.prod.example.

# Host ports
APP_PORT=8471
FRONTEND_PORT=5471

# Replace with your own random values (for example: openssl rand -hex 32). The database keeps the POSTGRES_PASSWORD it
# was created with: changing it once the database has data needs `docker compose down -v`, which deletes the data.
POSTGRES_PASSWORD=!ChangeMe!
APP_DATABASE_PASSWORD=!ChangeMe!
APP_SECRET=!ChangeMe!
